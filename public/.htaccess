# Apache (for example XAMPP): send every request that is not a real file to Index.php.
RewriteEngine On

# Keep the Authorization header, which some Apache setups drop before PHP sees it.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ Index.php [L]
